XYTRONIX-MIB DEFINITIONS ::= BEGIN

IMPORTS
        OBJECT-GROUP, NOTIFICATION-GROUP
                FROM SNMPv2-CONF
        enterprises, MODULE-IDENTITY, OBJECT-TYPE, NOTIFICATION-TYPE
                FROM SNMPv2-SMI
        DisplayString
                FROM SNMPv2-TC;

x410 MODULE-IDENTITY
        LAST-UPDATED "202009101200Z"
        ORGANIZATION "Xytronix Research & Design"
        CONTACT-INFO "www.ControlByWeb.com"
        DESCRIPTION "X-410 MIB"
        REVISION "202009101200Z"
        DESCRIPTION "Added object and notification groups."
        ::= {enterprises 30586 46}

xytronix          OBJECT IDENTIFIER ::= {enterprises 30586}

io                OBJECT IDENTIFIER ::= {x410 0}
pulseTimer        OBJECT IDENTIFIER ::= {x410 1}
counter           OBJECT IDENTIFIER ::= {x410 2}
onTimer           OBJECT IDENTIFIER ::= {x410 3}
totalOnTimer      OBJECT IDENTIFIER ::= {x410 4}
frequency         OBJECT IDENTIFIER ::= {x410 5}

notifications                 OBJECT IDENTIFIER ::= {x410 100}
ioNotifications               OBJECT IDENTIFIER ::= {notifications 0}
counterNotifications          OBJECT IDENTIFIER ::= {notifications 2}
onTimerNotifications          OBJECT IDENTIFIER ::= {notifications 3}
totalOnTimerNotifications     OBJECT IDENTIFIER ::= {notifications 4}
frequencyNotifications        OBJECT IDENTIFIER ::= {notifications 5}

-- conformance information
snmpMIBConformance  OBJECT IDENTIFIER ::= { x410 500 }
snmpMIBCompliances  OBJECT IDENTIFIER ::= { snmpMIBConformance 1 }
snmpMIBGroups       OBJECT IDENTIFIER ::= { snmpMIBConformance 2 }

-- units of conformance


snmpGroup OBJECT-GROUP
  OBJECTS {
    digitalInput1,
    digitalInput2,
    digitalInput3,
    digitalInput4,
    relay1,
    relay2,
    relay3,
    relay4,
    vin,
    register1,
    relay1PulseTimer,
    relay2PulseTimer,
    relay3PulseTimer,
    relay4PulseTimer,
    digitalInput1Counter,
    digitalInput2Counter,
    digitalInput3Counter,
    digitalInput4Counter,
    digitalInput1OnTimer,
    digitalInput2OnTimer,
    digitalInput3OnTimer,
    digitalInput4OnTimer,
    digitalInput1TotalOnTimer,
    digitalInput2TotalOnTimer,
    digitalInput3TotalOnTimer,
    digitalInput4TotalOnTimer,
    digitalInput1Frequency,
    digitalInput2Frequency,
    digitalInput3Frequency,
    digitalInput4Frequency
  }
  STATUS  current
  DESCRIPTION
		"A collection of objects."
  ::= {snmpMIBGroups 8}


snmpBasicNotificationsGroup NOTIFICATION-GROUP
  NOTIFICATIONS {
    digitalInput1Notification,
    digitalInput2Notification,
    digitalInput3Notification,
    digitalInput4Notification,
    relay1Notification,
    relay2Notification,
    relay3Notification,
    relay4Notification,
    vinNotification,
    register1Notification,
    digitalInput1CounterNotification,
    digitalInput2CounterNotification,
    digitalInput3CounterNotification,
    digitalInput4CounterNotification,
    digitalInput1OnTimerNotification,
    digitalInput2OnTimerNotification,
    digitalInput3OnTimerNotification,
    digitalInput4OnTimerNotification,
    digitalInput1TotalOnTimerNotification,
    digitalInput2TotalOnTimerNotification,
    digitalInput3TotalOnTimerNotification,
    digitalInput4TotalOnTimerNotification,
    digitalInput1FrequencyNotification,
    digitalInput2FrequencyNotification,
    digitalInput3FrequencyNotification,
    digitalInput4FrequencyNotification
  }
  STATUS  current
  DESCRIPTION
		"A collection of notifications."
  ::= {snmpMIBGroups 9}


