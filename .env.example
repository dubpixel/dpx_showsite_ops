# Govee Cloud API Credentials
# Get API key from: https://developer.govee.com
GOVEE_API_KEY='your-api-key-here'
GOVEE_EMAIL='your-email@example.com'
GOVEE_PASSWORD='your-password-here'

# MQTT Broker Connection
# Leave these as localhost/127.0.0.1 unless using external MQTT broker
GOVEE_MQTT_HOST=127.0.0.1
GOVEE_MQTT_PORT=1883

# Timezone (optional)
# Use your local timezone for logging timestamps
TZ=America/New_York

# Logging Level
# Options: error, warn, info, debug, trace
# Recommended: info (default)
RUST_LOG=govee=info

# Temperature Display Units
# Options: F (Fahrenheit) or C (Celsius)
GOVEE_TEMPERATURE_SCALE=F

# BLE Decoder Configuration
# Site identifier for MQTT topic structure
SHOWSITE_NAME=demo_showsite

# Set-Schedule Service Configuration
# Port for the schedule web interface (production instance)
SCHEDULE_PORT=8000

# Stage/Festival Configuration
STAGE_NAME="Main Stage"
TIMEZONE=America/Los_Angeles

# Google Sheets Integration (optional)
# Set to 'true' to enable real-time schedule sync from Google Sheets
USE_GOOGLE_SHEETS=false
GOOGLE_SHEETS_ID=your-google-sheet-id-here
GOOGLE_SHEET_TAB=Schedule

# Path to Google service account JSON file (inside container)
# Place actual file in: secret/set-schedule-service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secret/set-schedule-service-account.json

# Art-Net DMX Integration (optional)
# Set to 'true' to enable brightness control via Art-Net
ARTNET_ENABLED=false
ARTNET_LISTEN_IP=0.0.0.0

# NTP Server Configuration
# Time synchronization service for network devices
# Upstream time source (NIST or other NTP pool)
NTP_UPSTREAM_POOL=time.nist.gov
ARTNET_PORT=6454
ARTNET_UNIVERSE=0
ARTNET_CHANNEL_START=1
ARTNET_CHANNEL_COUNT=3

# Grafana Dashboard Backup Configuration
# Used by backup-grafana-dashboards.py for automated backups
# IMPORTANT: Change this password before first deployment!
# This password is ONLY used on first boot - after that, change via Grafana UI
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-strong-password-here

# Relay Controllers & Environmental Monitors (Phase 7+8: Physical Control)
# Device IPs: Used by Telegraf for SNMP monitoring (hostname mappings via extra_hosts)
GEIST_IP=192.168.1.214
X410_IP=192.168.1.XXX
#
# Device inventory for control scripts: config/relays.conf
# Supports multiple Geist Watchdog and ControlByWeb X-410 devices
#
# SNMP Community Strings (SECRETS - default values, can be overridden per-device in config)
# Geist: Configure read-write community in Geist web UI for relay control
#   - Keep "public" read-only for Telegraf monitoring
#   - Use "private" (or custom) for write operations (relay control)
GEIST_SNMP_RW_COMMUNITY=private
#
# X-410: Default "public" works for both read and write on most X410 devices
X410_SNMP_COMMUNITY=public

# Netgear M4300 Backup System (Phase 5)
# Automated config backup for network switches via TFTP
M4300_USERNAME=admin
M4300_PASSWORD_M4300=password
M4300_PASSWORD_OTHER=Password1!
# IMPORTANT: TFTP server uses host networking mode (required for dynamic port allocation)
# Set this to your host machine's IP address on the same network as your switches
# Example: M4300_TFTP_SERVER=192.168.1.100
M4300_TFTP_SERVER=192.168.1.100  # Change to your host LAN IP
M4300_BACKUP_RETENTION_DAYS=30
# Switch inventory is configured in services/netgear-backup/switches.conf

# InfluxDB Connection (for metrics and monitoring)
# Used by netgear-backup service to publish backup metrics
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=my-super-secret-token
INFLUXDB_ORG=home
INFLUXDB_BUCKET=sensors

# Physical Control Service (Phase 7+8: Alert-Driven Automation)
# Webhook receiver for Grafana alerts → physical device actions
# Port for webhook receiver (Grafana will send alerts here)
PHYSICAL_CONTROL_PORT=5000

# Optional: Webhook authentication token for security
# If set, Grafana must include "Authorization: Bearer <token>" header
# Leave empty to disable authentication (LAN-only deployments)
WEBHOOK_AUTH_TOKEN=

# Guest Alert Button System (Phase 7+8: Button-to-Lamp Controller)
# Always-running service for X410 button/lamp automation
# Button Panel IP: 192.168.105.112 (4 colored button inputs)
# Lamp Controller IP: 192.168.105.111 (4 colored lamp relays + big red clear button)
# Health/metrics endpoint port
BUTTON_HEALTH_PORT=8080
# Blink frequency in Hz (1.0 = 1 blink/sec, 2.0 = 2 blinks/sec)
BUTTON_BLINK_HZ=2.0
# Logging level (DEBUG, INFO, WARNING, ERROR)
BUTTON_LOG_LEVEL=INFO

# ── WLED Bridge (Phase 7+: MQTT Sensor → WLED Ropelight) ────────────────────
# Maps sensor data to pixel zones on a WLED ropelight via WLED's native MQTT API.
# Requires WLED firmware with MQTT enabled (Config → Sync Interfaces → MQTT).
#
# Full WLED MQTT device topic — must match "Device topic" in WLED Config → Sync Interfaces → MQTT.
# WLED subscribes to: {WLED_DEVICE_TOPIC}/api for JSON segment commands.
# Example: coachella_26/wled-rambo  (group topic would be coachella_26/all)
WLED_DEVICE_TOPIC=coachella_26/wled-rambo
# Room name for the tent temperature sensor — must match the room assigned to the
# sensor in the Govee app or device-overrides.json.
# Appears as segment 4 of the BLE decoder MQTT topic:
#   {site}/dpx_ops_decoder/{gw}/{ROOM}/{device}/{mac}/temperature
TENT_SENSOR_ROOM=tent
FOH_SENSOR_ROOM=foh             # Room name for FOH sensor (from Govee API)

# ── WLED Matrix (17×10 LED matrix — scrolling text display) ─────────────────
# Separate WLED device from the ropelight above.
# One-time setup on the WLED device (wled-matrix):
#   Config → Sync Interfaces → MQTT → enable, set broker IP,
#     Device topic = value of WLED_MATRIX_TOPIC below
#   Config → LED Preferences → 2D Matrix → width=17 height=10 serpentine start=bottom-left
#
# Full MQTT base topic for the matrix device.
WLED_MATRIX_TOPIC=coachella_26/wled-matrix
# Scrolling text defaults — change in .env + iot wled-restart (no rebuild needed).
# Color is R,G,B comma-separated. Speed is 0-255. TTL is seconds before auto-clear.
WLED_MATRIX_DEFAULT_SPEED=255
WLED_MATRIX_DEFAULT_COLOR=255,220,0
WLED_MATRIX_DEFAULT_TTL=30
